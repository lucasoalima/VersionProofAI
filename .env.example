# Backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/versionproof
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/versionproof_test
APP_ENV=development
LOG_LEVEL=INFO
# Directory from which local ingestion is permitted (SSRF/path-traversal guard)
INGESTION_ROOT=../data
# Embeddings / LLM are OPTIONAL. Phase 1 runs without them.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
MIN_EVIDENCE_COVERAGE=0.5
# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
